# ============================================================================
# BUSINESS OS 2026 — OPEN SOURCE • MIT • SELF-HOSTED CONFIGURATION
# ============================================================================
# Application works 100% offline/local-first without any cloud or AI provider.
# All external connectors below are strictly OPTIONAL.

# 1. Self-Hosted Server & Database (Docker Compose / NestJS / PostgreSQL)
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://businessos:change_me_strong_password@postgres:5432/business_os_db
REDIS_URL=redis://redis:6379
JWT_SECRET=replace_with_64_byte_cryptographic_secret_key

# 2. Optional Pluggable Business AI Provider (DISABLED | LOCAL_DETERMINISTIC | OLLAMA | OPENAI_COMPATIBLE)
AI_ENABLED=false
AI_PROVIDER=LOCAL_DETERMINISTIC
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# 3. Optional Payment Webhook Secrets (Manual payments work without any keys)
MTN_MOMO_WEBHOOK_SECRET=OPTIONAL_MTN_WEBHOOK_SECRET
ORANGE_MONEY_WEBHOOK_SECRET=OPTIONAL_ORANGE_WEBHOOK_SECRET
CAMPAY_WEBHOOK_SECRET=OPTIONAL_CAMPAY_WEBHOOK_SECRET
MONEY_FUSION_WEBHOOK_SECRET=OPTIONAL_MONEY_FUSION_SECRET
STRIPE_WEBHOOK_SECRET=OPTIONAL_STRIPE_WEBHOOK_SECRET
PAYPAL_WEBHOOK_SECRET=OPTIONAL_PAYPAL_WEBHOOK_SECRET
